root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space
indent_size = 4

# YAML/TOML/JSON suelen ir a 2 espacios
[*.{yml,yaml,toml,json}]
indent_size = 2

# SQL: 2 espacios suele ayudar con anidaciones largas
[*.sql]
indent_size = 2

# Markdown: no recortar espacios (se usan para saltos de línea)
[*.md]
trim_trailing_whitespace = false

# Makefiles necesitan TABs, no espacios
[Makefile]
indent_style = tab

# Python: Black ya formatea; solo aseguramos 4 espacios y LF
[*.py]
indent_size = 4
end_of_line = lf
